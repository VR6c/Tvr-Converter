# Everything here is optional. Copy to .env.local only if you need it.
# YouTube key/BPM detection works with no configuration as long as yt-dlp and
# ffmpeg are installed on the machine running the server.

# Upstash Redis (REST). Without it results are cached in memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Spotify Web API. Without it every lookup goes straight to audio analysis.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Only if the binaries are not on PATH or in a standard location.
YT_DLP_PATH=""
FFMPEG_PATH=""

# Optional proxy for yt-dlp (e.g. http://user:pass@host:port). Set this on
# Vercel if YouTube keeps refusing requests from the deployment's IP.
YT_DLP_PROXY=""
